# Build configuration - single source of truth for the image build pipeline.
# Read by scripts/build-config.sh (GitHub Actions) and the unit tests.
# Every key is required; the scripts fail fast when one is missing or empty.

# --- Published image ---------------------------------------------------------
# GHCR requires a lowercase image name.
IMAGE_NAME=ghcr.io/hlidacstatu/matomo
# GHCR package name (last path segment of IMAGE_NAME), used for retention cleanup.
PACKAGE_NAME=matomo
# Platforms of the published image. Each extra platform is built under QEMU
# and slows every build considerably; add only what the servers actually run.
PLATFORMS=linux/amd64
# Platform of the candidate image that is smoke-tested on the runner.
TEST_PLATFORM=linux/amd64
# Number of newest package versions kept in GHCR; older ones are deleted.
KEEP_PACKAGE_VERSIONS=30
# OCI label carrying the content fingerprint (see scripts/image-fingerprint.sh).
FINGERPRINT_LABEL=cz.hlidacstatu.matomo.fingerprint

# --- Matomo ------------------------------------------------------------------
# Currently built Matomo version. Bumped automatically by release-check.yml.
MATOMO_VERSION=5.14.3
# Only releases of this major line are picked up automatically. Moving to a
# new major (e.g. 6) is a deliberate manual change of this value.
MATOMO_MAJOR=5
# Git remote whose tags announce Matomo releases.
MATOMO_GIT_URL=https://github.com/matomo-org/matomo.git
# Release tarballs and detached GPG signatures are downloaded from here.
MATOMO_DOWNLOAD_BASE_URL=https://builds.matomo.org
# Fingerprint of the Matomo release signing key (keys/matomo-release-signing-key.asc).
MATOMO_GPG_FINGERPRINT=F529A27008477483777FC23D63BB30D0E5D2C749
# Fallback GeoLite2 databases baked into the image (geoip-updater overrides them at runtime).
GEOIP_MMDB_BASE_URL=https://github.com/crazy-max/geoip-updater/raw/mmdb
# Unicode font used by the ImageGraph plugin.
UNIFONT_URL=https://matomo.org/wp-content/uploads/unifont.ttf.zip

# --- Base image --------------------------------------------------------------
# Alpine release branch. Security patches inside the branch are picked up by
# the daily rebuild; moving to a new branch (new PHP package names!) is manual.
ALPINE_VERSION=3.24

# --- Verification ------------------------------------------------------------
# Vulnerability scanner image (pinned by digest).
TRIVY_IMAGE=aquasec/trivy:0.76.2@sha256:8f6bb947dbc528902e11f2f5be52f7b519f6a39d5d148f41166f2040499768fb
# Severities listed in the scan report.
TRIVY_SEVERITY=HIGH,CRITICAL
# How long the smoke test waits for the stack to become healthy.
SMOKE_TEST_TIMEOUT_SECONDS=180
