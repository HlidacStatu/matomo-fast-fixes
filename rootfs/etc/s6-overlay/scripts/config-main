#!/bin/sh

SIDECAR_CRON=${SIDECAR_CRON:-0}

if [ "$SIDECAR_CRON" = "1" ]; then
  exit 0
fi

LOG_LEVEL=${LOG_LEVEL:-WARN}

# Check if already installed
if [ -f "/data/config/config.ini.php" ] && grep -q '^\[database\]' "/data/config/config.ini.php"; then
  echo "Setting Matomo log level to $LOG_LEVEL..."
  console config:set --section=log --key=log_level --value="$LOG_LEVEL"

  echo "Upgrading and setting Matomo configuration..."
  # Deviation from upstream: a failed database upgrade stops the container
  # (S6_BEHAVIOUR_IF_STAGE2_FAILS=2) instead of starting Matomo on a
  # half-migrated schema, so `docker compose up --wait` reports the failure.
  if ! console core:update --yes --no-interaction; then
    echo "ERROR: core:update failed" >&2
    exit 1
  fi
  console config:set --section=General --key=minimum_memory_limit --value=-1
else
  echo ">>"
  echo ">> Open your browser to install Matomo through the wizard"
  echo ">>"
fi
