# Settings of the migration test (test/migration/run.sh).
IT_REGISTRY=localhost:5000
IT_REGISTRY_BIND=127.0.0.1:5000
IT_REGISTRY_IMAGE=registry:2.8.3
IT_REGISTRY_CONTAINER=matomo-migration-registry
IT_DB_PASSWORD=asupersecretpassword
# Short grace period so the broken image is detected quickly.
IT_START_PERIOD=20s
IT_WAIT_TIMEOUT_SECONDS=200
