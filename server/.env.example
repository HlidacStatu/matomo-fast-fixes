# Copy to .env next to compose.yml and adjust. Never commit the real .env.

# Compose project name. Keep the name of the existing project (by default the
# name of the directory the old compose file lived in), otherwise compose
# creates a second set of containers next to the old ones.
COMPOSE_PROJECT_NAME=matomo

TZ=Europe/Prague

# Host directory holding db/, web/ and geoip-updater/ (bind mounts).
MATOMO_DATA_DIR=/data/matomo

# Images. Each tag tracks a supported release line and receives security
# rebuilds; matomo-update.sh pulls them and deploys when they change.
# Major version changes are deliberate edits of these values.
MATOMO_IMAGE=ghcr.io/hlidacstatu/matomo:5
# 10.11 is what the previous `mariadb:10` tag resolved to (LTS). Moving to a
# newer LTS (11.4, 11.8) is supported thanks to MARIADB_AUTO_UPGRADE=1, but
# do it manually and with a backup.
MARIADB_IMAGE=mariadb:10.11
# Redis holds only cache/queue data (no volume), so major upgrades are safe.
REDIS_IMAGE=redis:8-alpine
MSMTPD_IMAGE=crazymax/msmtpd:latest
GEOIP_UPDATER_IMAGE=crazymax/geoip-updater:latest

MATOMO_PUBLISHED_PORT=8000
# Grace period for Matomo DB migrations on container start (see compose.yml).
# Keep it below WAIT_TIMEOUT_SECONDS in matomo-update.env.
MATOMO_START_PERIOD=1800s

MYSQL_DATABASE=matomo
MYSQL_USER=matomo
MYSQL_PASSWORD=change-me

CRON_ARCHIVE=0 * * * *
ARCHIVE_OPTIONS=--concurrent-requests-per-website=3
