# Configuration of matomo-update.sh. Install as /etc/matomo-update/matomo-update.env
# (root-owned, mode 600 - the file is sourced by the script). All keys are required.

# Directory with compose.yml and .env of the Matomo stack.
COMPOSE_DIR=/opt/matomo

# Service names in compose.yml.
APP_SERVICE=matomo
CRON_SERVICE=cron
DB_SERVICE=db

# Pre-update backups (database dump + Matomo config) and their retention.
BACKUP_DIR=/data/matomo/backups
BACKUP_RETENTION_DAYS=14

# Persistent state (list of image IDs that failed to deploy).
STATE_DIR=/var/lib/matomo-update
# JSON lines log (also written to stdout / journald).
LOG_FILE=/var/log/matomo-update/matomo-update.log
LOCK_FILE=/run/lock/matomo-update.lock

# How long `docker compose up --wait` may take. Must cover Matomo DB
# migrations, i.e. be larger than MATOMO_START_PERIOD in the stack's .env.
WAIT_TIMEOUT_SECONDS=2400

# HTTP check after the update (any status below 400 passes). The tracker
# endpoint is used because it is what visitors hit and, unlike the UI, it is
# not subject to trusted_hosts or force_ssl redirects.
HEALTH_URL=http://127.0.0.1:8000/matomo.php
HEALTH_RETRIES=10
HEALTH_TIMEOUT_SECONDS=20

# Unused images older than this are pruned after a successful run.
IMAGE_PRUNE_UNTIL=168h
