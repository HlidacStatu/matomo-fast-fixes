# Template: @UPDATE_SCRIPT@ and @UPDATE_CONFIG@ are replaced by quoted paths
# in server/install-timer.sh. Do not copy this file to /etc/systemd/system as is.
[Unit]
Description=Update the Matomo Docker stack (pull, backup, deploy, verify, rollback)
Documentation=https://github.com/HlidacStatu/matomo-fast-fixes
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=@UPDATE_SCRIPT@ @UPDATE_CONFIG@
# Must be longer than the backup, WAIT_TIMEOUT_SECONDS and a possible rollback.
TimeoutStartSec=3h
# When the start times out (or the unit is stopped) the script gets SIGTERM
# and rolls back: restoring the dump and waiting for the old stack must fit
# here (the default 90s would SIGKILL a rollback half way).
TimeoutStopSec=2h
Nice=10
# Backups and logs hold credentials.
UMask=0077
