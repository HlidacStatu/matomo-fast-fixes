[Unit]
Description=Update the Matomo Docker stack (pull, backup, deploy, verify, rollback)
Documentation=https://github.com/HlidacStatu/matomo-fast-fixes
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/matomo-fast-fixes/server/matomo-update.sh /etc/matomo-update/matomo-update.env
# Must be longer than WAIT_TIMEOUT_SECONDS plus a possible rollback.
TimeoutStartSec=3h
Nice=10
