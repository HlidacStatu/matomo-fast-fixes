[Unit]
Description=Run matomo-update twice a day
Documentation=https://github.com/HlidacStatu/matomo-fast-fixes

[Timer]
# Twice a day keeps the worst case "Matomo release -> running in production"
# below 24 hours: release check every 3 h + build + at most 12 h until the
# next run. A run without new images is a no-op (no restart, no backup).
OnCalendar=*-*-* 05:15:00
OnCalendar=*-*-* 17:15:00
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
